{
  "expo": {
    "name": "DAS DORF",
    "slug": "das-dorf",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "dasdorf",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090D0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dasdorf.game",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.dasdorf.game",
      "adaptiveIcon": {
        "backgroundColor": "#101518",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DAS DORF nutzt die Kamera nur zum Scannen des Raum-QR-Codes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B84532"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DAS DORF nutzt dein Foto nur als Profilbild für diese Partie.",
          "cameraPermission": "DAS DORF nutzt die Kamera nur für ein Profilfoto für diese Partie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}